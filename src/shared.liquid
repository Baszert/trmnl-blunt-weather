{%- comment -%} === DATA === {%- endcomment -%}
{% assign temperature          = temperature | round %}
{% assign apparent_temperature = apparent_temperature | round %}
{% assign weather_code         = weather_code %}
{% assign precipitation_chance = precipitation_probability %}
{% assign unit                 = unit | default: "°C" %}

{%- comment -%} === TIJD (voor random index) === {%- endcomment -%}

{% assign utc            = trmnl.system.timestamp_utc %}
{% assign offset         = trmnl.user.utc_offset %}
{% assign local_ts       = utc | plus: offset %}
{% assign current_minute = local_ts | date: "%M" | plus: 0 %}

{%- comment -%} === SUNRISE / SUNSET FORMATTING === {%- endcomment -%}

{% assign sunrise_fmt = sunrise | date: "%H:%M" %}
{% assign sunset_fmt  = sunset  | date: "%H:%M" %}

{%- comment -%} === WEER CATEGORIE === {%- endcomment -%}

{% assign rain_incoming = false %}
{% if precipitation_chance > 50 %}
  {% assign rain_incoming = true %}
{% endif %}

{% assign weather_category = "" %}
{% case weather_code %}
  {% when 0, 1 %}
    {% if rain_incoming %}
      {% assign weather_category = "sunny_but" %}
    {% else %}
      {% assign weather_category = "sunny" %}
    {% endif %}
  {% when 2, 3 %}
    {% if rain_incoming %}
      {% assign weather_category = "cloudy_but" %}
    {% else %}
      {% assign weather_category = "cloudy" %}
    {% endif %}
  {% when 45, 48 %}
    {% assign weather_category = "foggy" %}
  {% when 51, 53, 55, 56, 57 %}
    {% assign weather_category = "drizzle" %}
  {% when 61, 63, 80, 81 %}
    {% assign weather_category = "rain" %}
  {% when 65, 82 %}
    {% assign weather_category = "heavy_rain" %}
  {% when 66, 67 %}
    {% assign weather_category = "freezing_rain" %}
  {% when 71, 73, 85 %}
    {% assign weather_category = "snow" %}
  {% when 75, 77, 86 %}
    {% assign weather_category = "heavy_snow" %}
  {% when 95, 96, 99 %}
    {% assign weather_category = "storm" %}
  {% else %}
    {% assign weather_category = "cloudy" %}
{% endcase %}

{%- comment -%} === ZINNEN PER CATEGORIE === {%- endcomment -%}

{%- comment -%} 10 zinnen per categorie, index 0-9 via minuut modulo 10 {%- endcomment -%}
{% assign mood_index = current_minute | modulo: 10 %}

